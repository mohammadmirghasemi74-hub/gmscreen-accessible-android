<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginVertical="3dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="@drawable/card_channel_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Channel Number Badge -->
    <TextView
        android:id="@+id/txtPickerChannelNumber"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/badge_pill_bg"
        android:text="1"
        android:textColor="@color/accent_yellow"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Channel Name and Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtPickerChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شبکه یک"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtPickerChannelType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تلویزیون"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Selected Indicator Checkmark / Pill -->
    <TextView
        android:id="@+id/badgePickerSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_playing_pill"
        android:text="انتخاب شده"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:visibility="gone" />

</LinearLayout>
