<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:background="@drawable/card_channel_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Channel Number Badge -->
    <TextView
        android:id="@+id/txtChannelNumber"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@drawable/badge_pill_bg"
        android:text="1"
        android:textColor="@color/accent_yellow"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Channel Type Graphic Icon (TV / Radio) -->
    <ImageView
        android:id="@+id/imgChannelType"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_tv_display"
        android:importantForAccessibility="no" />

    <!-- Channel Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="شبکه سه"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Playing Badge -->
            <TextView
                android:id="@+id/badgePlaying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="در حال پخش"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_playing_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <!-- HD Badge -->
            <TextView
                android:id="@+id/badgeHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_hd_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <!-- Scrambled Badge -->
            <TextView
                android:id="@+id/badgeLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کارتی $"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_lock_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Satellite and Frequency -->
        <TextView
            android:id="@+id/txtChannelDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="بدر ۵ • ۱۱۸۸۱ MHz"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Live Play Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLivePlay"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="@string/btn_play_channel"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_play_vector"
        app:iconGravity="textStart"
        app:backgroundTint="@color/primary"
        app:cornerRadius="22dp" />

</LinearLayout>
