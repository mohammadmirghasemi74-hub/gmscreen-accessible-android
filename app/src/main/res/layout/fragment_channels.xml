<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- Top Controls Bar: TV/Radio on Left, Filter on Right, Search in Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:padding="6dp">

        <!-- TV / Radio Toggle (Left) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTvRadioToggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/mode_tv"
            android:contentDescription="تغییر حالت به رادیو یا تلویزیون"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

        <!-- Search Bar with dynamic Clear button (Center) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/badge_bg"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="8dp">

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_channels_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- Clear Search Button: visible ONLY when text is typed -->
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/btn_clear_search"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Satellite Filter Button (Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSatelliteFilter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="ماهواره‌ها"
            android:contentDescription="انتخاب و فیلتر ماهواره"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/card_bg"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Channel Count & Filter Info Header -->
    <TextView
        android:id="@+id/txtChannelCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="در حال بارگذاری کانال‌ها…"
        android:textColor="@color/accent_yellow"
        android:textSize="13sp"
        android:focusable="true" />

    <!-- Live Player View (Collapsible) -->
    <LinearLayout
        android:id="@+id/containerPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/txtPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="پخش زنده"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopPlayer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_stop_stream"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:use_controller="true" />
    </LinearLayout>

    <!-- Channels RecyclerView: takes entire remaining screen -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="4dp"
        android:clipToPadding="false" />

</LinearLayout>
