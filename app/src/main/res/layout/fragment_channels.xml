<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- Top Controls Bar: TV/Radio on Left, Filter on Right, Search in Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:padding="6dp">

        <!-- TV / Radio Toggle (Left) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTvRadioToggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/mode_tv"
            android:contentDescription="تغییر حالت به رادیو یا تلویزیون"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

        <!-- Search Bar with dynamic Clear button (Center) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/badge_bg"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="8dp">

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_channels_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- Clear Search Button: visible ONLY when text is typed -->
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/btn_clear_search"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Satellite Filter Button (Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSatelliteFilter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="ماهواره‌ها"
            android:contentDescription="انتخاب و فیلتر ماهواره"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/card_bg"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Channel Count & Filter Info Header -->
    <TextView
        android:id="@+id/txtChannelCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="در حال بارگذاری کانال‌ها…"
        android:textColor="@color/accent_yellow"
        android:textSize="13sp"
        android:focusable="true" />

    <!-- Persistent Audio Playback Bar (Shown only when playing audio-only) -->
    <LinearLayout
        android:id="@+id/layoutAudioPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B5E20"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtAudioPlayingChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="در حال پخش صوتی: ..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopAudioPlayback"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="توقف پخش صوتی"
            android:contentDescription="توقف پخش صوتی در گوشی"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Jump to First / Last Channel Buttons Row (Visibility controlled by Settings) -->
    <LinearLayout
        android:id="@+id/layoutJumpButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJumpToFirstChannel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▲ پرش به اولین کانال"
            android:contentDescription="پرش به ابتدای لیست کانال‌ها (کانال اول)"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/card_bg"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJumpToLastChannel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="▼ پرش به آخرین کانال"
            android:contentDescription="پرش به انتهای لیست کانال‌ها (کانال آخر)"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/card_bg"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Channels Container with Refresh FAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="4dp"
            android:clipToPadding="false" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabRecordings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:text="ضبط‌ها"
            android:contentDescription="مشاهده فایل‌های ضبط‌شده در حافظه گوشی"
            android:textColor="@color/white"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/white"
            app:backgroundTint="@color/secondary" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabRefreshChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="به‌روزرسانی"
            android:contentDescription="به‌روزرسانی لیست شبکه‌ها از رسیور"
            android:textColor="@color/white"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconTint="@color/white"
            app:backgroundTint="@color/primary" />

    </FrameLayout>

</LinearLayout>
