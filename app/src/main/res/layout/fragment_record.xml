<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 1. Section: Record on Phone -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_phone_section"
                    android:textColor="@color/accent_yellow"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtPhoneRecStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضعیت ضبط گوشی: آماده (ذخیره در پوشه gm screen android/recordings)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartPhoneVideoRec"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_start_record_video"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:backgroundTint="@color/accent_red"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartPhoneAudioRec"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_start_record_audio"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    app:icon="@android:drawable/ic_btn_speak_now"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopPhoneRec"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_stop_phone_record"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/secondary"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="فایل‌های ضبط شده در گوشی:"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/containerRecordedFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNoRecordings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="هنوز فایلی در گوشی ضبط نشده است."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:padding="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Section: Record on Receiver USB / PVR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_receiver_section"
                    android:textColor="@color/accent_green"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtStbRecStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضعیت ضبط رسیور: ضبط مستقیم روی فلش مموری متصل به پورت USB رسیور انجام می‌شود."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStbInstantRecord"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_stb_instant_record"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/accent_red"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStbStopRecord"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_stb_stop_record"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:backgroundTint="@color/secondary"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
