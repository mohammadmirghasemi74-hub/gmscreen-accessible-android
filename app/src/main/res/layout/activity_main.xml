<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- Top Accessible Navigation Bar -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActiveTab"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="سربرگ فعال: اتصال (برای تغییر کلیک کنید)"
            android:contentDescription="سربرگ فعال: اتصال. برای تغییر سربرگ دو بار ضربه بزنید"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconTint="@color/accent_yellow"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Main ViewPager: full screen display for current tab only -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
