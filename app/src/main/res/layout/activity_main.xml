<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- Top Accessible Navigation & Status Bar -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F1420"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActiveTab"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="سربرگ فعال: اتصال به رسیور (کلیک برای تغییر)"
            android:contentDescription="سربرگ فعال: اتصال به رسیور. برای تغییر سربرگ دو بار ضربه بزنید. برای شنیدن گزارش وضعیت رسیور، لمس طولانی کنید."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconTint="@color/accent_yellow"
            app:backgroundTint="#192438"
            app:strokeColor="#38517A"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <!-- Main ViewPager: full screen display for current tab only -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
