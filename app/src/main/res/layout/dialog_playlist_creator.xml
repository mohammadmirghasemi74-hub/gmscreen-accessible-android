<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="12dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ساخت و تولید لیست پخش (M3U)"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 1. Mode Selector (At Top as requested) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حالت ساخت فایل‌های لیست پخش:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlaylistMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="تولید فایل‌های مجزا برای هر شبکه (تک‌تک - پیش‌فرض)"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="#243447"
        app:cornerRadius="8dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp" />

    <!-- 2. Select All, Deselect All, and Count Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="انتخاب همه"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="6dp" />

        <TextView
            android:id="@+id/txtSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۰ از ۰"
            android:textColor="@color/accent_yellow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeselectAll"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="لغو انتخاب"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            app:backgroundTint="@color/card_border"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- 3. Search Bar -->
    <EditText
        android:id="@+id/edtSearchChannel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/search_box_bg"
        android:hint="جست‌وجوی کانال..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="10dp"
        android:textSize="13sp"
        android:singleLine="true"
        android:layout_marginBottom="6dp" />

    <!-- 4. Channels List (Middle) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChannels"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#151d26"
        android:scrollbars="vertical"
        android:layout_marginBottom="10dp" />

    <!-- 5. Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGeneratePlaylists"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:text="ساخت پلی‌لیست"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="بستن"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/card_border"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
