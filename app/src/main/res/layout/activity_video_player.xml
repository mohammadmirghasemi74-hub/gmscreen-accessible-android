<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Edge-to-edge Video View without intrusive ExoPlayer overlay controls -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Top Floating Translucent Controls Bar (Subtle & Elegant) -->
    <RelativeLayout
        android:id="@+id/topControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Close / Exit Button (Translucent circular Glassmorphism button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePlayer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:contentDescription="بستن پخش‌کننده و بازگشت به لیست کانال‌ها"
            app:cornerRadius="22dp"
            android:alpha="0.65"
            app:backgroundTint="#66000000"
            app:strokeColor="#44FFFFFF"
            app:strokeWidth="1dp" />

        <!-- Center Live Channel Badge -->
        <TextView
            android:id="@+id/txtChannelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/search_box_bg"
            android:backgroundTint="#66000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="🔴 پخش زنده"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:alpha="0.75" />

        <!-- Record Toggle Button (Translucent circular/pill Glassmorphism button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleRecordInPlayer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="● ضبط"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:contentDescription="شروع ضبط مستقیم روی حافظه گوشی"
            app:cornerRadius="22dp"
            android:alpha="0.65"
            app:backgroundTint="#66000000"
            app:strokeColor="#44FFFFFF"
            app:strokeWidth="1dp" />

    </RelativeLayout>

</FrameLayout>
