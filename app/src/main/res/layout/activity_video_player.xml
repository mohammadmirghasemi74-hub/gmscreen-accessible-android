<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="4000"
        app:surface_type="surface_view" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExitPlayer"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="توقف و بازگشت (یا کلید برگشت)"
        android:contentDescription="توقف پخش و بازگشت به لیست کانال‌ها"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="#DD990000"
        app:cornerRadius="8dp" />

    <TextView
        android:id="@+id/txtPlayerOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:background="#99000000"
        android:padding="8dp" />

</FrameLayout>
