<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="3000"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Discrete, fully accessible exit button for screen readers (visually unobtrusive to sighted viewers) -->
    <ImageButton
        android:id="@+id/btnExitPlayer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:alpha="0.08"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="خروج از پخش زنده و بستن صفحه"
        android:importantForAccessibility="yes"
        app:tint="@color/white" />

    <!-- Instant Record Toggle Button inside Video Player -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleRecordInPlayer"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="شروع ضبط"
        android:contentDescription="شروع ضبط زنده این شبکه روی گوشی"
        app:cornerRadius="21dp"
        android:alpha="0.7"
        android:backgroundTint="#CCB71C1C"
        android:textColor="@color/white"
        android:textSize="12sp" />

</FrameLayout>
