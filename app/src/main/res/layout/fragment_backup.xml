<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Storage Hero Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_backup_storage"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پشتیبان‌گیری، ذخیره‌سازی و پلی‌لیست‌ها"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 1. STB USB Hardware Backup Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="۱. پشتیبان‌گیری سخت‌افزاری روی فلش رسیور (USB)"
                    android:textColor="@color/accent_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtBackupDeviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مدل رسیور متصل: نامشخص"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="روش بکاپ‌گیری سخت‌افزاری متناسب با مدل:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectBackupMethod"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="۱. تشخیص خودکار هوشمند (توصیه‌شده)"
                    android:contentDescription="روش بکاپ‌گیری سخت‌افزاری: تشخیص خودکار هوشمند. برای تغییر دو بار ضربه بزنید."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="#243447"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackupStbUsb"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="شروع بکاپ‌گیری سخت‌افزاری روی فلش رسیور"
                    android:contentDescription="شروع بکاپ‌گیری مستقیم از کانال‌ها و تنظیمات روی فلش متصل به رسیور"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_green"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Phone Export and Storage Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="۲. ذخیره‌سازی اطلاعات شبکه‌ها روی حافظه گوشی"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="خروجی گرفتن از تمام کانال‌ها در قالب فایل‌های Word، TXT، HTML و JSON"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportChannels"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ذخیره‌سازی اطلاعات شبکه‌ها (Word, TXT, HTML, JSON)..."
                    android:contentDescription="ذخیره‌سازی و تولید خروجی از کانال‌ها با انتخاب فرمت"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="#1e88e5"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageBackups"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="مشاهده و مدیریت فایل‌های ذخیره‌شده"
                    android:contentDescription="مشاهده، باز کردن، اشتراک‌گذاری یا حذف فایل‌های ذخیره‌شده روی گوشی"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="#374151"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. M3U Playlists Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="۳. ساخت و مدیریت پلی‌لیست‌های M3U (جهت پخش در VLC)"
                    android:textColor="@color/accent_amber"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تولید فایل‌های لیست پخش استاندارد Sat>IP برای پخش با یک کلیک در VLC"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenPlaylistCreator"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ساخت و تنظیمات پلی‌لیست شبکه‌ها (M3U)..."
                    android:contentDescription="باز کردن پنجره ساخت و شخصی‌سازی فایل‌های لیست پخش ام تری یو"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="#0284c7"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManagePlaylists"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="مشاهده و مدیریت فایل‌های پلی‌لیست (M3U)"
                    android:contentDescription="مشاهده، پخش مستقیم، اشتراک‌گذاری یا حذف فایل‌های پلی‌لیست ام تری یو"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="#374151"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status TextView -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_yellow"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
