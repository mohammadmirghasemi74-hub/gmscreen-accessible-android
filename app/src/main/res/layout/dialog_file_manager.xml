<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مدیریت فایل‌های ذخیره‌شده"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Count, Sort Toggle and Delete All Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtFilesCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تعداد: ۰ فایل"
            android:textColor="@color/accent_yellow"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSortOrder"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:text="ترتیب: صعودی (۱ به آخر)"
            android:contentDescription="ترتیب فایل‌ها: صعودی از ۱ به آخر. برای تغییر به نزولی ضربه بزنید."
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1dp"
            app:backgroundTint="#162234"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAllFiles"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="حذف همه"
            android:contentDescription="حذف تمام فایل‌های موجود در این لیست"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/accent_red"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/txtEmptyFiles"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="هیچ فایلی ذخیره نشده است."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Files List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFiles"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#121824"
        android:scrollbars="vertical"
        android:padding="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="بستن"
        android:contentDescription="بستن پنجره مدیریت فایل‌ها"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="#243044"
        app:cornerRadius="10dp" />

</LinearLayout>
